      "cps": 10
    },
    {
      "action": "wait",
      "ms": 1000
    },
    {
      "action": "click",
      "target": "generate_btn"
    },
    {
      "action": "wait",
      "ms": 6000
    },
    {
      "action": "click",
      "target": "play_btn"
    },
    {
      "action": "wait",
      "ms": 4000
    }
