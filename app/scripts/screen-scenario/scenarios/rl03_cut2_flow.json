{
  "id": "rl03_cut2_flow",
  "_note": "RL03 CUT 2 — Google Flow 화면 녹화. ★Flow 탭이 '프로젝트 안'(.../flow/project/...)에 있어야 프롬프트 입력창이 존재함. 랜딩/목록 페이지면 실패. driver:cdp=대상 탭 CDP 직결. recorder:native=Page.startScreencast. 결정적 대안 = make_graphic_cut + rl03_screen.html.",
  "driver": "cdp",
  "recorder": "native",
  "duration": 9,
  "viewport": {
    "width": 1080,
    "height": 1920
  },
  "target": "flow",
  "record": {
    "fps": 30,
    "windowTitle": "Flow"
  },
  "selectors": {
    "prompt_box": "textarea, [contenteditable='true'], [role='textbox']",
    "generate_btn": {
      "text": "만들기"
    },
    "results_grid": "[class*='grid'], [class*='result']"
  },
  "steps": [
    {
      "action": "wait",
      "ms": 2000
    },
    {
      "action": "type",
      "target": "prompt_box",
      "text": "young korean woman, 서여리, cinematic portrait",
      "cps": 14
    },
    {
      "action": "wait",
      "ms": 800
    },
    {
      "action": "click",
      "target": "generate_btn"
    },
    {
      "action": "wait",
      "ms": 4000
    },
    {
      "action": "scroll",
      "target": "results_grid",
      "by": 500,
      "duration": 2500
    },
    {
      "action": "wait",
      "ms": 400
    }
  ],
  "for": {
    "cut": 2,
    "episodeCode": "IG_R03"
  }
}