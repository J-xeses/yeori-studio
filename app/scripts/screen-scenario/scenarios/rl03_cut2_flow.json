{
  "id": "rl03_cut2_flow",
  "_note": "RL03 CUT 2 — Google Flow 화면: 프롬프트 입력 → 서여리 이미지들 스크롤. 실제 사이트 대상이라 로그인된 Chrome 프로필 필요 + selectors는 UI 변경 시 갱신. 결정적 버전은 make_graphic_cut + rl03_screen.html.",
  "driver": "puppeteer",
  "recorder": "native",
  "duration": 9,
  "viewport": { "width": 1080, "height": 1920 },
  "target": { "url": "https://labs.google/fx/ko/tools/flow", "waitUntil": "networkidle2", "timeout": 60000 },
  "record": { "fps": 30, "windowTitle": "Flow", "windowPosition": { "x": 40, "y": 20 } },
  "selectors": {
    "prompt_box": "textarea",
    "generate_btn": { "text": "만들기" },
    "results_grid": "[class*='grid'], [class*='result']"
  },
  "steps": [
    { "action": "wait", "ms": 2000 },
    { "action": "type", "target": "prompt_box", "text": "young korean woman, 서여리, cinematic portrait", "cps": 14 },
    { "action": "wait", "ms": 800 },
    { "action": "click", "target": "generate_btn" },
    { "action": "wait", "ms": 4000 },
    { "action": "scroll", "target": "results_grid", "by": 500, "duration": 2500 },
    { "action": "wait", "ms": 400 }
  ]
}
